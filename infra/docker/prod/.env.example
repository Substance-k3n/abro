# Copy to .env on the server (never commit .env). docs/DEPLOY.md.

# Public hostnames -- both A/AAAA records must point at this server.
# Web and API are sibling subdomains so the session cookie (SameSite=Lax)
# is sent on the web app's API calls.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Postgres. Use a long random, URL-safe password (e.g. `openssl rand -hex 32`)
# -- it's embedded in a connection URL.
POSTGRES_USER=abro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=abro

# Receipt storage (internal only). Random values, e.g. `openssl rand -hex 20`.
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
RECEIPTS_BUCKET=abro-receipts

# OTP email (ADR-004). Without a key, codes are only printed to the api log.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ABRO <no-reply@example.com>
# Or, with no verified domain, Brevo (ADR-013): sender = an address you
# verified in Brevo. Only used when RESEND_API_KEY is empty.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Optional Google sign-in. Callback URL is derived: https://$API_DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SESSION_TTL_DAYS=30

# Optional: prebuilt images instead of building on the server.
# WEB_IMAGE=ghcr.io/substance-k3n/abro-web:latest
# API_IMAGE=ghcr.io/substance-k3n/abro-api:latest
