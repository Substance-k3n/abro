// Auth mechanism decided 2026-09-16 (see docs/DECISIONS.md ADR-004):
// DB-backed sessions + Email OTP + Google OAuth, both linking to the same
// Profile by email so a user who signs in via OTP and later via Google (or
// vice versa) lands on one account, not two.

enum OAuthProvider {
  GOOGLE
}

// Only the SHA-256 hash of the session token is ever stored — the raw token
// lives only in the client's httpOnly cookie. A leaked DB row can't be
// replayed as a session on its own.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// One row per OTP send. Never updated in place except to mark consumedAt —
// codeHash so a DB read alone can't be used to sign in. Not linked to
// Profile: the email may not have an account yet at send time.
model OtpCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email, consumedAt])
  @@map("otp_codes")
}

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}
