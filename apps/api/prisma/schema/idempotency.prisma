// docs/BACKEND_PLAN.md item 5 (hardening pass): idempotency keys on
// financial-record-creating POSTs. A client-supplied `Idempotency-Key`
// header, scoped per user + endpoint, lets a retried request (e.g. after a
// timeout where the write actually succeeded but the response never
// arrived) return the original result instead of creating a duplicate
// Expense/Settlement.
model IdempotencyKey {
  id        String   @id @default(cuid())
  userId    String
  // Client-generated (e.g. a UUID); opaque to the server.
  key       String
  // "METHOD path", e.g. "POST /expenses" -- same key value reused for a
  // different endpoint must not collide.
  endpoint  String
  // Null while the guarded operation is still in flight (this row is a
  // reservation, written before running it, so a concurrent duplicate
  // request fails fast on the unique constraint instead of racing to run
  // the operation twice) -- set once it completes, to the full response
  // body as it will be sent to the client (see IdempotencyService's doc
  // comment on the BigInt/Date -> JSON-plain shape this stores).
  response  Json?
  createdAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id])

  @@unique([userId, key, endpoint])
  @@map("idempotency_keys")
}
