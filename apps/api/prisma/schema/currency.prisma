// Point-in-time rate snapshot. ABRO_PRD.md §27: conversions are point-in-time —
// a historical expense's conversion never gets recomputed when rates change.
// Each rate refresh INSERTS a new row; existing rows are never updated in
// place, so an Expense.conversionId keeps pointing at the exact rate it used
// forever. (The original single-file schema had @@unique([currencyFrom,
// currencyTo]) here, which would have forced upsert-in-place semantics and
// broken that invariant — removed in favor of a non-unique index.)
model CurrencyRate {
  id           String   @id @default(cuid())
  currencyFrom String
  currencyTo   String
  rate         Decimal  @db.Decimal(20, 10)
  fetchedAt    DateTime @default(now())

  expenses Expense[]

  @@index([currencyFrom, currencyTo])
  @@map("currency_rates")
}
