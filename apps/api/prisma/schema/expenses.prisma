// Mirrors @abro/types SplitType — kept in sync manually, since Prisma enums
// can't import from a TS package. SETTLEMENT is a ledger event sharing this
// discriminant, per ABRO_PRD.md §14.
enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
  SETTLEMENT
}

model Expense {
  id           String    @id @default(cuid())
  // Nullable: a personal IOU has no group, per ABRO_FRONTEND_SPEC.md EXP-01
  // ("Group (optional) — 'None (personal IOU)' option").
  groupId      String?
  name         String
  category     String
  // Integer minor units — see users.prisma's file-level note. Never Float.
  amount       BigInt
  currency     String    @default("ETB")
  paidById     String
  splitType    SplitType
  expenseDate  DateTime
  receiptPath  String?
  notes        String?
  // Points at the exact CurrencyRate snapshot used at creation time — never
  // recomputed when rates later change (see currency.prisma).
  conversionId String?
  deletedAt    DateTime?
  deletedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  updatedById  String?

  group            Group?               @relation(fields: [groupId], references: [id])
  paidBy           Profile              @relation("ExpensePaidBy", fields: [paidById], references: [id])
  deletedBy        Profile?             @relation("ExpenseDeletedBy", fields: [deletedById], references: [id])
  updatedBy        Profile?             @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])
  conversion       CurrencyRate?        @relation(fields: [conversionId], references: [id], onDelete: Restrict)
  participants     ExpenseParticipant[]
  expenseNotes     ExpenseNote[]
  // Present only when this expense is a recurring template's source row.
  recurringExpense RecurringExpense?

  @@index([paidById])
  @@index([groupId])
  @@index([expenseDate])
  @@index([deletedAt])
  @@index([conversionId])
  @@map("expenses")
}

model ExpenseParticipant {
  id        String @id @default(cuid())
  expenseId String
  userId    String
  // This participant's share, in minor units. sum(amount) across an expense's
  // participants MUST equal Expense.amount — enforced server-side, not by the DB.
  amount    BigInt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    Profile @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_participants")
}

model ExpenseNote {
  id        String   @id @default(cuid())
  expenseId String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  author  Profile @relation(fields: [authorId], references: [id])

  @@index([expenseId])
  @@map("expense_notes")
}
