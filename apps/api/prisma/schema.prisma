// ABRO data model — translated from docs/ABRO_PRD.md §29 into Prisma.
//
// Financial correctness rules this schema exists to uphold (ABRO_PRD.md §8, §45):
//   - Money is always BigInt minor units. Never Float, never Decimal for amounts.
//   - Expense + ExpenseParticipant are the source of truth; Balance is NOT a table —
//     it's computed (a view, or a service-layer query) from these two models plus
//     Settlement. Do not add a stored "balance" column anywhere.
//   - Soft-delete only: Expense.deletedAt, never a hard delete, per ABRO_PRD.md §8.5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum GroupType {
  FRIENDS
  TRIP
  HOUSEHOLD
  FAMILY
  TEAM
  OTHER
}

enum GroupMemberRole {
  ADMIN
  MEMBER
}

enum GroupMemberStatus {
  INVITED
  ACTIVE
  LEFT
}

// Mirrors @abro/types SplitType — kept in sync manually, since Prisma enums
// can't import from a TS package. SETTLEMENT is a ledger event sharing this
// discriminant, per ABRO_PRD.md §14.
enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
  SETTLEMENT
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Profile {
  id                String   @id @default(cuid())
  displayName       String
  avatarUrl         String?
  phone             String?  @unique
  email             String?  @unique
  preferredCurrency String   @default("ETB")
  locale            String   @default("en")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  friendshipsInitiated Friendship[]        @relation("FriendshipUser")
  friendshipsReceived  Friendship[]        @relation("FriendshipFriend")
  groupMemberships     GroupMember[]
  groupsCreated        Group[]             @relation("GroupCreatedBy")
  expensesPaid         Expense[]           @relation("ExpensePaidBy")
  expensesDeleted      Expense[]           @relation("ExpenseDeletedBy")
  expensesUpdated      Expense[]           @relation("ExpenseUpdatedBy")
  expenseParticipant   ExpenseParticipant[]
  expenseNotes         ExpenseNote[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]

  @@map("profiles")
}

// A → B friendship request. Query both directions when resolving "is X my friend".
model Friendship {
  id        String           @id @default(cuid())
  userId    String
  friendId  String
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())

  user   Profile @relation("FriendshipUser", fields: [userId], references: [id])
  friend Profile @relation("FriendshipFriend", fields: [friendId], references: [id])

  @@unique([userId, friendId])
  @@map("friendships")
}

model Group {
  id            String    @id @default(cuid())
  name          String
  type          GroupType @default(OTHER)
  currency      String    @default("ETB")
  simplifyDebts Boolean   @default(true)
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy Profile       @relation("GroupCreatedBy", fields: [createdById], references: [id])
  members   GroupMember[]
  expenses  Expense[]

  @@map("groups")
}

model GroupMember {
  id       String            @id @default(cuid())
  groupId  String
  userId   String
  role     GroupMemberRole   @default(MEMBER)
  status   GroupMemberStatus @default(ACTIVE)
  joinedAt DateTime          @default(now())

  group Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  Profile @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@map("group_members")
}

model Expense {
  id           String    @id @default(cuid())
  // Nullable: a personal IOU has no group, per ABRO_FRONTEND_SPEC.md EXP-01
  // ("Group (optional) — 'None (personal IOU)' option").
  groupId      String?
  name         String
  category     String
  // Integer minor units — see the file-level note. Never Float.
  amount       BigInt
  currency     String    @default("ETB")
  paidById     String
  splitType    SplitType
  expenseDate  DateTime
  receiptPath  String?
  notes        String?
  conversionId String?
  deletedAt    DateTime?
  deletedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  updatedById  String?

  group        Group?               @relation(fields: [groupId], references: [id])
  paidBy       Profile              @relation("ExpensePaidBy", fields: [paidById], references: [id])
  deletedBy    Profile?             @relation("ExpenseDeletedBy", fields: [deletedById], references: [id])
  updatedBy    Profile?             @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])
  participants ExpenseParticipant[]
  expenseNotes ExpenseNote[]

  @@index([paidById])
  @@index([groupId])
  @@index([expenseDate])
  @@index([deletedAt])
  @@map("expenses")
}

model ExpenseParticipant {
  id        String @id @default(cuid())
  expenseId String
  userId    String
  // This participant's share, in minor units. sum(amount) across an expense's
  // participants MUST equal Expense.amount — enforced server-side, not by the DB.
  amount    BigInt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    Profile @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_participants")
}

model ExpenseNote {
  id        String   @id @default(cuid())
  expenseId String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  author  Profile @relation(fields: [authorId], references: [id])

  @@map("expense_notes")
}

// Cached rate snapshot. ABRO_PRD.md §27: conversions are point-in-time —
// a historical expense's conversion never gets recomputed when rates change.
model CurrencyRate {
  id           String   @id @default(cuid())
  currencyFrom String
  currencyTo   String
  rate         Decimal  @db.Decimal(20, 10)
  updatedAt    DateTime @updatedAt

  @@unique([currencyFrom, currencyTo])
  @@map("currency_rates")
}

model RecurringExpense {
  id                String             @id @default(cuid())
  templateExpenseId String             @unique
  frequency         RecurringFrequency
  nextRunAt         DateTime
  enabled           Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("recurring_expenses")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user Profile @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Profile @relation(fields: [userId], references: [id])

  @@map("push_subscriptions")
}
