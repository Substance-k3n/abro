PORT=3201

# postgresql://<user>:<password>@localhost:<port>/<db>
DATABASE_URL="postgresql://abro:password@localhost:5460/abro"

# CORS: the web app's origin. Also where /auth/google/callback redirects after sign-in.
WEB_ORIGIN="http://localhost:3200"

# Session cookie TTL, in days. See docs/DECISIONS.md ADR-004.
SESSION_TTL_DAYS=30

# Google OAuth — from a Google Cloud Console project (OAuth client ID, Web
# application type). Leave unset in dev: /auth/google responds 501 instead
# of crashing until these are filled in. Callback must be registered in
# Google Cloud Console as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3201/auth/google/callback"
