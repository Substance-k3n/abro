# infra/docker/dev/compose.yml's default Postgres, port 5460 to avoid
# colliding with a system-wide Postgres on the standard 5432.
DATABASE_URL=postgres://abro:password@localhost:5460/abro?sslmode=disable

PORT=3201
WEB_ORIGIN=http://localhost:3200
NODE_ENV=development
SESSION_TTL_DAYS=30

# docs/DECISIONS.md ADR-004 -- Google OAuth. Leave unset in dev; the
# /auth/google endpoint responds 501 until these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3201/auth/google/callback

# docs/DECISIONS.md ADR-004 -- Resend, for real OTP email delivery. Leave
# unset in dev; OTP codes are logged to the console instead of emailed
# until both of these are set (see internal/auth.ConsoleOTPMailer).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# docs/DECISIONS.md ADR-013 -- Brevo, the no-domain alternative to Resend
# (one verified sender address can email anyone). Only used when the
# Resend vars are empty. BREVO_SENDER_NAME defaults to "ABRO".
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# docs/DECISIONS.md ADR-006/ADR-008 -- RustFS (self-hosted S3-compatible),
# started by infra/docker/dev/compose.yml alongside Postgres. The
# `abro-minio` key predates the MinIO -> RustFS switch; it's just a name.
S3_ENDPOINT=http://localhost:9460
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=abro-minio
S3_SECRET_ACCESS_KEY=password123
RECEIPTS_BUCKET=abro-receipts

# docs/DECISIONS.md ADR-021 -- phone/browser push. Generate a pair with
# `go run ./cmd/vapidkeys`; empty means notifications stay in-app only.
# VAPID_SUBJECT defaults to WEB_ORIGIN.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# docs/DECISIONS.md ADR-027 -- voice commands through Tezaz. Relay URL and
# secret key both set turns voice on, only for the emails in VOICE_TESTERS
# (comma-separated, or "*" for everyone). Empty means no voice button.
TEZAZ_RELAY_URL=
TEZAZ_SECRET_KEY=
TEZAZ_PUBLIC_KEY=
VOICE_TESTERS=

# docs/DECISIONS.md ADR-028 -- admin portal. Comma-separated emails that are
# super admins even without a site_admins row, so the owner can't be locked
# out. Empty means only roles stored in the database count.
ADMIN_EMAILS=

# Deploy only (apps/api/start.sh, ADR-012): "true" makes the container run
# database migrations before starting the API. Not read by `go run`.
# RUN_MIGRATIONS=true
