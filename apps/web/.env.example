# The ABRO API this frontend talks to.
NEXT_PUBLIC_API_URL="http://localhost:3201"

# Free-tier deploy only (docs/DEPLOY.md "Free tier", ADR-012): set
# NEXT_PUBLIC_API_URL="/api" and point this at the API's real origin so
# next.config.mjs forwards /api/* there. Leave unset everywhere else.
# API_PROXY_TARGET="https://abro-api.onrender.com"
